# ============================================================
# SHALOM Backend — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données PostgreSQL (Supabase) ---
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.[PROJET_ID].supabase.co:5432/postgres

# --- JWT — Access Token ---
JWT_SECRET=votre_secret_jwt_acces_token_minimum_32_caracteres
JWT_EXPIRES_IN=15m

# --- JWT — Refresh Token ---
JWT_REFRESH_SECRET=votre_secret_jwt_refresh_token_minimum_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS — Origines autorisées (séparées par des virgules) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Wallet — CinetPay (intégration réelle, Checkout API) ---
# apikey et site_id : identifiants marchand du tableau de bord CinetPay.
# secret_key : clé secrète servant à calculer/vérifier le X-TOKEN HMAC des
# notifications (mécanisme distinct de l'apikey — cf. doc officielle).
# Sans ces 3 valeurs, aucune recharge CinetPay n'est possible (échec explicite
# à l'initiation) et aucune notification ne peut être créditée (fail-closed).
# Doc : https://docs.cinetpay.com/api/1.0-fr/checkout/initialisation
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Wallet — FedaPay (reste un STUB, non intégré) ---
FEDAPAY_WEBHOOK_SECRET=votre_secret_webhook_fedapay

# --- Email (SMTP) — envoi du code de vérification à l'inscription ---
# Ex. Gmail SMTP : host=smtp.gmail.com, port=587, secure=false, user=votre
# adresse Gmail, password=un "mot de passe d'application" généré dans les
# paramètres de sécurité Google (pas votre mot de passe Gmail habituel).
# Sans ces valeurs, les codes sont journalisés en console (dev uniquement).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_adresse@example.com
SMTP_PASSWORD=votre_mot_de_passe_smtp
SMTP_FROM=SHALOM <no-reply@shalom.app>

# --- Administration ---
# Emails reconnus comme admin (isAdminEmail()), séparés par des virgules —
# la colonne users.role n'est pas utilisée comme mécanisme d'admin.
ADMIN_EMAILS=admin@shalom.app

# --- URLs publiques ---
# Origine du frontend en production — utilisée pour les liens générés côté
# backend (ex: lien "rejoindre" dans les emails/notifications ambassadeur).
FRONTEND_URL=https://votre-domaine-frontend.example
# Origine publique de CE backend — utilisée pour construire des URLs
# absolues vers les fichiers téléversés (avatars, médias...).
PUBLIC_URL=https://votre-domaine-backend.example

# --- Uploads ---
# Quota de stockage par utilisateur (en Mo) pour POST /api/v1/uploads.
# Défaut si absent : 500.
UPLOAD_QUOTA_MB=500
